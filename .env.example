PORT=3000
HOST=127.0.0.1
DATA_DIR=./.data
ORGANIZATION_NAME=MultiServicios

# Credenciales OAuth 2.0 tipo "Aplicación web" de Google Cloud.
# Habilita Google Drive API y Gmail API; permisos: drive.file y gmail.send.
# URI autorizada: http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Clientes - Visa Canada
GOOGLE_DRIVE_USA_ROOT_FOLDER_NAME=Clientes - Visa USA

# 64 caracteres hex. `npm run setup` genera una clave segura automáticamente.
APP_ENCRYPTION_KEY=

WHATSAPP_AUTOSTART=true
WHATSAPP_BROWSER_VISIBLE=false
WHATSAPP_SESSION_ID=acme-client-intake
WHATSAPP_DEVICE_NAME=MultiServicios Client Intake
# Único cliente de pruebas autorizado para iniciar su propio flujo.
TEST_SELF_START_PHONE=
# Sólo este número puede ordenar el respaldo ZIP completo por WhatsApp.
BACKUP_ADMIN_PHONE=
# Ejemplo: C:\Users\TuUsuario\OneDrive\Desktop
FULL_BACKUP_OUTPUT_DIR=
# Normalmente se detecta automáticamente en Windows.
CHROME_EXECUTABLE_PATH=
MAX_DOCUMENT_MB=20

# Integración futura con OpenAI. La clave real debe existir únicamente en .env;
# nunca la escribas en este archivo ni la subas a GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_CONVERSATION_ENABLED=false
