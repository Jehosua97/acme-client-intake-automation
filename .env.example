PORT=3000
HOST=127.0.0.1
DATA_DIR=./.data
ORGANIZATION_NAME=ACME

# Credenciales OAuth 2.0 tipo "Aplicación web" de Google Cloud.
# URI autorizada: http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=ACME - Client Files

# 64 caracteres hex. `npm run setup` genera una clave segura automáticamente.
APP_ENCRYPTION_KEY=

WHATSAPP_AUTOSTART=true
WHATSAPP_BROWSER_VISIBLE=false
WHATSAPP_SESSION_ID=acme-client-intake
WHATSAPP_DEVICE_NAME=ACME Client Intake
# Normalmente se detecta automáticamente en Windows.
CHROME_EXECUTABLE_PATH=
MAX_DOCUMENT_MB=20
