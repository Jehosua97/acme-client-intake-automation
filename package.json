{
  "name": "acme-client-intake-automation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/server.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "node dist/src/server.js",
    "windows:install": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-startup.ps1",
    "windows:status": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows-bot-status.ps1",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "googleapis": "^160.0.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
